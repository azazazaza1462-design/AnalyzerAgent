# API origin. Leave empty in dev (the Vite proxy forwards /api/* to the backend).
# In QA/prod set it to the API App Service origin, e.g.
# https://lendlogic-analyzer-api-qa-cus-XXXX.centralus-01.azurewebsites.net
# Do NOT include a path — the SDK/calls already use absolute /api/v1/... paths.
VITE_API_BASE_URL=

# Microsoft Entra ID (Azure AD) sign-in.
# VITE_ENTRA_CLIENT_ID is required — the App Registration (client) ID.
# VITE_ENTRA_TENANT_ID defaults to the Viewnear tenant when unset.
# VITE_ENTRA_REDIRECT_URI defaults to the app origin (e.g. http://localhost:5173) when unset.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
